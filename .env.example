RAVEN_HOME=/path/to/raven-data
RAVEN_CONSOLE_LOG=info
RAVEN_FILE_LOG=debug
RAVEN_LOG_MAX_BYTES=1048576
RAVEN_LOG_MAX_FILES=3
# Set RAVEN_API_TOKEN to a freshly generated secret with at least 16 visible ASCII characters.
RAVEN_API_BIND_HOST=127.0.0.1
RAVEN_API_BIND_PORT=3002
RAVEN_UI_PATH=/path/to/raven-ui
